# CSS Modules Patterns

## File Naming

### Naming Convention

- Use kebab-case for CSS Module files
- Match component name: `event-card.module.css` for `event-card.tsx`
- Place in same directory as component

```
components/
├── event-card.tsx
└── event-card.module.css
```

## CSS Module Usage

### Basic Import

```typescript
import styles from './event-card.module.css';

export function EventCard() {
  return <div className={styles.card}>Content</div>;
}
```

### Multiple Classes

```typescript
import styles from './event-card.module.css';
import clsx from 'clsx';

export function EventCard({ isExpanded }: { isExpanded: boolean }) {
  return (
    <div className={clsx(styles.card, isExpanded && styles.expanded)}>
      Content
    </div>
  );
}
```

### Conditional Classes with clsx

```typescript
// ✅ Good - use clsx for conditional classes
import clsx from 'clsx';

export function Button({ variant, size, className }: ButtonProps) {
  return (
    <button
      className={clsx(
        styles.button,
        styles[variant],
        styles[size],
        className
      )}
    >
      Content
    </button>
  );
}

// ❌ Bad - string concatenation
export function Button({ variant }: ButtonProps) {
  return (
    <button className={`${styles.button} ${styles[variant]}`}>
      Content
    </button>
  );
}
```

## CSS Class Naming

### Naming Convention

- Use kebab-case for class names
- Use descriptive names
- Use BEM-like structure when appropriate

```css
/* ✅ Good */
.card {
  /* ... */
}

.card-header {
  /* ... */
}

.card-content {
  /* ... */
}

.card-footer {
  /* ... */
}

.card-header-title {
  /* ... */
}

/* ❌ Bad */
.cardHeader {
  /* ... */
}

.card_header {
  /* ... */
}
```

