## Form Hook Pattern

### Custom Form Hook

```typescript
export function useEventForm(event?: Event) {
  const form = useForm<EventFormData>({
    resolver: zodResolver(EventSchema),
    defaultValues: event ? {
      title: event.title,
      content: event.content,
      date: event.date,
      tags: event.tags,
    } : {
      title: '',
      content: '',
      tags: [],
    },
  });

  const createMutation = useCreateEvent();
  const updateMutation = useUpdateEvent();

  const onSubmit = form.handleSubmit(async (data) => {
    try {
      if (event) {
        await updateMutation.mutateAsync({ id: event.id, data });
      } else {
        await createMutation.mutateAsync(data);
      }
    } catch (error) {
      // Handle server-side errors
      if (isApiError(error) && error.errors) {
        Object.entries(error.errors).forEach(([field, messages]) => {
          form.setError(field as keyof EventFormData, {
            type: 'server',
            message: messages[0],
          });
        });
      } else {
        form.setError('root', {
          type: 'server',
          message: getErrorMessage(error),
        });
      }
    }
  });

  return {
    form,
    onSubmit,
    isLoading: createMutation.isPending || updateMutation.isPending,
    error: createMutation.error || updateMutation.error,
  };
}
```

## Async Validation

### Async Field Validation

```typescript
const EventSchema = z.object({
  title: z.string().min(1, 'Title is required'),
  slug: z.string().min(1, 'Slug is required'),
});

export function useEventForm() {
  const form = useForm<EventFormData>({
    resolver: zodResolver(EventSchema),
  });

  // Async validation for slug uniqueness
  const validateSlug = async (slug: string) => {
    const isUnique = await checkSlugUniqueness(slug);
    if (!isUnique) {
      return 'This slug is already taken';
    }
    return true;
  };

  return (
    <form>
      <input {...form.register('title')} />
      <input
        {...form.register('slug', {
          validate: validateSlug,
        })}
      />
    </form>
  );
}
```

### Debounced Async Validation

```typescript
export function useEventForm() {
  const form = useForm<EventFormData>();
  const [slugValue, setSlugValue] = useState('');
  const debouncedSlug = useDebounce(slugValue, 500);

  useEffect(() => {
    if (debouncedSlug) {
      checkSlugUniqueness(debouncedSlug).then((isUnique) => {
        if (!isUnique) {
          form.setError('slug', {
            type: 'validate',
            message: 'This slug is already taken',
          });
        } else {
          form.clearErrors('slug');
        }
      });
    }
  }, [debouncedSlug, form]);

  return (
    <form>
      <input
        {...form.register('slug')}
        onChange={(e) => {
          setSlugValue(e.target.value);
          form.setValue('slug', e.target.value);
        }}
      />
    </form>
  );
}
```

## Multi-Step Forms

### Wizard Form Pattern

```typescript
interface WizardFormProps {
  steps: React.ReactNode[];
}

export function WizardForm({ steps }: WizardFormProps) {
  const [currentStep, setCurrentStep] = useState(0);
  const form = useForm<EventFormData>();

  const next = form.handleSubmit(() => {
    if (currentStep < steps.length - 1) {
      setCurrentStep(currentStep + 1);
    }
  });

  const previous = () => {
    if (currentStep > 0) {
      setCurrentStep(currentStep - 1);
    }
  };

  const onSubmit = form.handleSubmit((data) => {
    console.log('Final submit', data);
  });

  return (
    <form onSubmit={currentStep === steps.length - 1 ? onSubmit : next}>
      {steps[currentStep]}
      <div>
        {currentStep > 0 && (
          <button type="button" onClick={previous}>
            Previous
          </button>
        )}
        <button type="submit">
          {currentStep === steps.length - 1 ? 'Submit' : 'Next'}
        </button>
      </div>
    </form>
  );
}
```

## Dynamic Fields

### Array Field Pattern

```typescript
export function TagsField({ form }: { form: UseFormReturn<EventFormData> }) {
  const { fields, append, remove } = useFieldArray({
    control: form.control,
    name: 'tags',
  });

  return (
    <div>
      <label>Tags</label>
      {fields.map((field, index) => (
        <div key={field.id}>
          <input {...form.register(`tags.${index}`)} />
          <button type="button" onClick={() => remove(index)}>
            Remove
          </button>
        </div>
      ))}
      <button type="button" onClick={() => append('')}>
        Add Tag
      </button>
    </div>
  );
}
```

## Form Submission

### Submission with Loading State

```typescript
export function EventForm() {
  const form = useEventForm();
  const { isLoading, error } = form;

  return (
    <form onSubmit={form.onSubmit}>
      <InputField name="title" label="Title" form={form.form} />
      <TextareaField name="content" label="Content" form={form.form} />

      {error && (
        <div role="alert" className={styles.error}>
          {getErrorMessage(error)}
        </div>
      )}

      <button type="submit" disabled={isLoading}>
        {isLoading ? 'Saving...' : 'Save'}
      </button>
    </form>
  );
}
```

### Submission with Success State

```typescript
export function useEventForm() {
  const form = useForm<EventFormData>({
    resolver: zodResolver(EventSchema),
  });

  const createMutation = useCreateEvent();
  const [isSuccess, setIsSuccess] = useState(false);

  const onSubmit = form.handleSubmit(async (data) => {
    try {
      await createMutation.mutateAsync(data);
      setIsSuccess(true);
      form.reset();
      setTimeout(() => setIsSuccess(false), 3000);
    } catch (error) {
      // Handle error
    }
  });

  return {
    form,
    onSubmit,
    isLoading: createMutation.isPending,
    isSuccess,
  };
}
```

## Form Reset

### Reset After Submission

```typescript
export function useEventForm() {
  const form = useForm<EventFormData>({
    resolver: zodResolver(EventSchema),
  });

  const createMutation = useCreateEvent();

  const onSubmit = form.handleSubmit(async (data) => {
    try {
      await createMutation.mutateAsync(data);
      form.reset(); // Reset form after successful submission
    } catch (error) {
      // Handle error
    }
  });

  return { form, onSubmit };
}
```

### Reset to Specific Values

```typescript
export function useEventForm(event?: Event) {
  const form = useForm<EventFormData>({
    resolver: zodResolver(EventSchema),
    defaultValues: event,
  });

  // Reset form when event changes
  useEffect(() => {
    if (event) {
      form.reset(event);
    }
  }, [event, form]);

  return { form };
}
```

## Form Validation Patterns

### Conditional Validation

```typescript
const EventSchema = z.object({
  type: z.enum(['public', 'private']),
  password: z.string().optional(),
}).refine(
  (data) => {
    if (data.type === 'private' && !data.password) {
      return false;
    }
    return true;
  },
  {
    message: 'Password is required for private events',
    path: ['password'],
  }
);
```

### Cross-Field Validation

```typescript
const EventSchema = z
  .object({
    startDate: z.string().datetime(),
    endDate: z.string().datetime(),
  })
  .refine((data) => new Date(data.endDate) > new Date(data.startDate), {
    message: 'End date must be after start date',
    path: ['endDate'],
  });
```

