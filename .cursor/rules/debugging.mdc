# Debugging Guidelines

## React DevTools

### Component Inspection

- Use React DevTools to inspect component tree
- Check component props and state
- Use Profiler to identify performance issues
- Inspect component render times

### React Query DevTools

```typescript
// Enable React Query DevTools in development
import { ReactQueryDevtools } from '@tanstack/react-query-devtools';

export function App() {
  return (
    <>
      {/* Your app */}
      {process.env.NODE_ENV === 'development' && <ReactQueryDevtools />}
    </>
  );
}
```

## Console Debugging

### Structured Logging

```typescript
// ✅ Good - structured logging
console.log('[EventCard]', {
  eventId: event.id,
  isExpanded,
  isLoading,
});

// ❌ Bad - unstructured logging
console.log('EventCard', event, isExpanded, isLoading);
```

### Log Levels

```typescript
// Use appropriate log levels
console.debug('Debug information', data);
console.info('Info message', data);
console.warn('Warning message', data);
console.error('Error message', error);
```

### Debug Helpers

```typescript
// Create debug helpers
export function debugEvent(event: Event) {
  console.group('Event Debug');
  console.log('ID:', event.id);
  console.log('Title:', event.title);
  console.log('Date:', event.date);
  console.log('Full object:', event);
  console.groupEnd();
}
```

## Network Debugging

### API Request Debugging

```typescript
// Add request logging interceptor
apiClient.interceptors.request.use((config) => {
  if (process.env.NODE_ENV === 'development') {
    console.log('[API Request]', {
      method: config.method?.toUpperCase(),
      url: config.url,
      data: config.data,
    });
  }
  return config;
});

// Add response logging interceptor
apiClient.interceptors.response.use(
  (response) => {
    if (process.env.NODE_ENV === 'development') {
      console.log('[API Response]', {
        url: response.config.url,
        status: response.status,
        data: response.data,
      });
    }
    return response;
  },
  (error) => {
    if (process.env.NODE_ENV === 'development') {
      console.error('[API Error]', {
        url: error.config?.url,
        status: error.response?.status,
        message: error.message,
        data: error.response?.data,
      });
    }
    return Promise.reject(error);
  }
);
```

### Network Tab

- Use browser DevTools Network tab
- Check request/response headers
- Verify request payloads
- Check response status codes
- Monitor request timing

## State Debugging

### Zustand State Inspection

```typescript
// Add state logging in development
export const useAuthStore = create<AuthState>((set, get) => ({
  user: null,
  login: (user) => {
    if (process.env.NODE_ENV === 'development') {
      console.log('[AuthStore] Login:', user);
    }
    set({ user });
  },
}));

// Subscribe to state changes
useAuthStore.subscribe((state) => {
  if (process.env.NODE_ENV === 'development') {
    console.log('[AuthStore] State changed:', state);
  }
});
```

